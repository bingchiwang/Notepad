<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_cal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- 頂部月份導覽與快速新增按鈕（放大年份與月份字體） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/widget_cal_config_button"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="5dp"
            android:contentDescription="@string/widget_calendar_name"
            android:padding="2dp"
            android:src="@drawable/ic_widget_calendar" />

        <LinearLayout
            android:id="@+id/widget_cal_prev_button"
            android:layout_width="28dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_cal_nav_bg"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="上一個月"
                android:src="@drawable/ic_widget_chevron_left" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_cal_month_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="2026年 1月"
            android:textColor="@color/widget_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/widget_cal_next_button"
            android:layout_width="28dp"
            android:layout_height="30dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_cal_nav_bg"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="下一個月"
                android:src="@drawable/ic_widget_chevron_right" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_cal_lunar_toggle"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_chip_bg"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="7dp"
            android:text="農曆 ✓"
            android:textColor="@color/widget_chip_text"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/widget_cal_add_button"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="快速建立記事或待辦"
                android:src="@drawable/ic_widget_add" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="新增"
                android:textColor="@color/widget_on_accent"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 星期列（日 一 二 三 四 五 六；星期日「日」為紅色） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="4dp"
        android:weightSum="7">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="日"
            android:textColor="@color/widget_cal_sunday_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="一"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="二"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="三"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="四"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="五"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="六"
            android:textColor="@color/widget_cal_today_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 星期標題下方橫線 -->
    <TextView
        android:id="@+id/widget_cal_header_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_cal_cell_border" />

    <!-- 依當月實際週數（4~6 週）動態顯示之週次列，每週之間僅以橫線區隔 -->
    <LinearLayout
        android:id="@+id/widget_cal_week_0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="7" />

    <TextView
        android:id="@+id/widget_cal_divider_1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_cal_cell_border" />

    <LinearLayout
        android:id="@+id/widget_cal_week_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="7" />

    <TextView
        android:id="@+id/widget_cal_divider_2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_cal_cell_border" />

    <LinearLayout
        android:id="@+id/widget_cal_week_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="7" />

    <TextView
        android:id="@+id/widget_cal_divider_3"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_cal_cell_border" />

    <LinearLayout
        android:id="@+id/widget_cal_week_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="7" />

    <TextView
        android:id="@+id/widget_cal_divider_4"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_cal_cell_border" />

    <LinearLayout
        android:id="@+id/widget_cal_week_4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="7" />

    <TextView
        android:id="@+id/widget_cal_divider_5"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_cal_cell_border" />

    <LinearLayout
        android:id="@+id/widget_cal_week_5"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="7" />
</LinearLayout>
