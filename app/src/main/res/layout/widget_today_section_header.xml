<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="2dp"
    android:paddingTop="4dp"
    android:paddingBottom="2dp">

    <ImageView
        android:id="@+id/widget_today_section_icon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="5dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_checklist" />

    <TextView
        android:id="@+id/widget_today_section_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/widget_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_today_section_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_chip_bg"
        android:paddingHorizontal="8dp"
        android:paddingVertical="1dp"
        android:textColor="@color/widget_chip_text"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
