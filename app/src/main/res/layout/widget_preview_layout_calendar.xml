            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1.5dp" android:background="@drawable/widget_cal_note_pill_bg" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:paddingHorizontal="2dp" android:text="筆記" android:textColor="@color/widget_cal_note_text" android:textSize="8sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|center_horizontal" android:orientation="vertical" android:padding="2dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="6" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="廿八" android:textColor="@color/widget_text_secondary" android:textSize="8sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|center_horizontal" android:orientation="vertical" android:padding="2dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="7" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" />
