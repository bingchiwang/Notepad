<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_card_bg"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- 左側記事色條 -->
    <ImageView
        android:id="@+id/widget_item_color_bar"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/widget_accent"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 標題列（釘選圖示 + 記事圖示 + 標題 + 分類標籤 + 時間） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_item_pin"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="已釘選"
                android:src="@drawable/ic_widget_pin"
                android:visibility="gone" />

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_note_doc" />

            <TextView
                android:id="@+id/widget_item_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="記事標題"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_item_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_chip_bg"
                android:drawableStart="@drawable/ic_widget_category"
                android:drawablePadding="2dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="分類"
                android:textColor="@color/widget_chip_text"
                android:textSize="10sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_item_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:drawableStart="@drawable/ic_widget_clock"
                android:drawablePadding="2dp"
                android:gravity="center_vertical"
                android:text="11/15 18:30"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 記事內容摘要 -->
        <TextView
            android:id="@+id/widget_item_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="記事內容預覽..."
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
